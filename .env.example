# Safe-by-default local mode. Demo mode never calls a paid AI service.
PSYDESIGN_MODE=demo

# Required only after explicitly switching demo mode off.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Optional runtime configuration.
PSYDESIGN_DATABASE_PATH=./brand_history.db
PSYDESIGN_GENERATED_DIR=./data/generated
# Leave unset for the app to create a private local secret. Set an independent
# random 32+ character value through a secret manager for managed deployments.
# PSYDESIGN_SESSION_SECRET=replace_with_an_independent_random_value
PSYDESIGN_SESSION_COOKIE=psydesign_session
PSYDESIGN_SESSION_MAX_AGE=2592000
PSYDESIGN_COOKIE_SECURE=false
PSYDESIGN_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]

# Cost-control limits per client and rolling window.
PSYDESIGN_RATE_WINDOW=60
PSYDESIGN_GENERATE_RATE_LIMIT=6
PSYDESIGN_CHAT_RATE_LIMIT=30
PSYDESIGN_TTS_RATE_LIMIT=20
